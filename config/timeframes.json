{
  "timeframes": {
    "1d": {
      "label": "일봉",
      "intervalSeconds": 86400,
      "googleWindow": "2Y",
      "googleChartMode": 7,
      "sheetsLookbackDays": 1500,
      "sheetsInitialLookbackDays": 730,
      "backfillChunkDays": 10,
      "backfillTargetBars": 900,
      "enabled": true
    },
    "1w": {
      "label": "주봉",
      "intervalSeconds": 604800,
      "aggregateFrom": "1d",
      "aggregateRule": "ohlcv_weekly",
      "enabled": true,
      "maxBars": 200
    },
    "1mo": {
      "label": "월봉",
      "intervalSeconds": 2592000,
      "aggregateFrom": "1d",
      "aggregateRule": "ohlcv_monthly",
      "enabled": true,
      "maxBars": 120
    }
  }
}
